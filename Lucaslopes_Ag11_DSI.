import colorama
from colorama import Fore, Style

# Inicializa o colorama para garantir compatibilidade
colorama.init(autoreset=True)

def definir_alerta(nivel):
    """Retorna a mensagem e a cor correspondente ao nível."""
    niveis = {
        1: (Fore.RED, "Muito baixo (crítico)"),
        2: (Fore.YELLOW, "Baixo"),
        3: (Fore.GREEN, "Médio"),
        4: (Fore.CYAN, "Alto"),
        5: (Fore.BLUE, "Muito alto (alerta)")
    }
    return niveis.get(nivel, (Fore.WHITE, "Nível Inválido"))

def exibir_status():
    print(f"{'='*40}")
    print(f"{'SISTEMA DE MONITORAMENTO DE ÁGUA':^40}")
    print(f"{'='*40}\n")

    # Simulação dos 5 níveis solicitados
    simulacao_niveis = [1, 2, 3, 4, 5]

    for nivel in simulacao_niveis:
        cor, mensagem = definir_alerta(nivel)
        print(f"Status do Reservatório (Nível {nivel}): {cor}{mensagem}")

    print(f"\n{'='*40}")
    print("Monitoramento finalizado.")

if __name__ == "__main__":
    exibir_status()
